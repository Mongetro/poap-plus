# =============================================================================
# POAP+ Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholder values
#

# Alchemy API Key - Required for blockchain connectivity
# Get from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ⚠️  TESTNET PRIVATE KEY - EXTREMELY SENSITIVE
# Use only testnet wallets with NO REAL FUNDS!
TESTNET_PRIVATE_KEY=your_testnet_private_key_here

# Etherscan API Key - Required for contract verification
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ⚠️  SECURITY WARNING: Never commit .env file with real private keys!