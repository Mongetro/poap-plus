# =============================================================================
# POAP+ Front-end Environment Configuration
# =============================================================================

# Copy this file to .env and replace the placeholder values with your actual keys
#

# Alchemy API Key - Required for blockchain connectivity
# Get from: https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Pinata JWT Token - ESSENTIAL for IPFS uploads
# Get from: https://pinata.cloud/
VITE_PINATA_JWT=your_pinata_jwt_token_here


# ⚠️  SECURITY WARNING: Never commit .env file with real keys!